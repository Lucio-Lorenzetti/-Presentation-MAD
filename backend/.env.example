# ─── ARCA (ex AFIP) — Web Services de Facturación Electrónica ───────────────

# false = ambiente de homologación (testing, no fiscal)
# true  = ambiente de producción (factura real, con validez fiscal)
ARCA_PRODUCTION=false

# CUIT de la inmobiliaria (el emisor de las facturas), sin guiones. Ej: 20111111112
ARCA_CUIT=

# Punto de venta habilitado en ARCA para Web Services (se crea/consulta en
# "Puntos de Venta y Domicilios" dentro del portal de ARCA)
ARCA_PTO_VENTA=1

# Rutas al certificado y clave privada (ver backend/README.md para cómo generarlos).
# NUNCA subir estos archivos a git.
ARCA_CERT_PATH=./certs/cert.pem
ARCA_KEY_PATH=./certs/private.key

# ─── Datos fiscales del emisor (para el PDF de la factura) ──────────────────

# RI = Responsable Inscripto | MONOTRIBUTO = Monotributista
EMISOR_CONDICION_IVA=RI
EMISOR_RAZON_SOCIAL="Inmobiliaria MAD"
EMISOR_DOMICILIO="Bahía Blanca, Buenos Aires"

# ─── Servidor ────────────────────────────────────────────────────────────────
PORT=3001
